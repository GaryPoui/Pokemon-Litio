[node name="Cartel" type="Node2D" parent="." unique_id=1342646835]
position = Vector2(248, 200)
script = ExtResource("5_rj58i")
texto = "CAMINITO · LA BOCA

Al sur: Centro Pokémon, café y kiosco. Al este: la Bombonera y la plaza. Al oeste: el puerto."

[node name="Npc" parent="." unique_id=1999008602 instance=ExtResource("6_1p004")]
position = Vector2(360, 280)
script = ExtResource("9_8xvfq")
texto_elegir = "¿Cuál te llevás?"
texto = "¡Hola! Mantené Shift para correr.

En las rutas, la hierba alta está llena de Pokémon salvajes. ¡Tené cuidado!"
texto_regalo = "¡Hola! ¿Todavía no tenés un Pokémon?

Tengo tres que buscan compañero de viaje. Elegí el que más te guste."


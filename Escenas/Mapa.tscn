salida = Vector2(1, 0)
tiempo_paso = 0.22
texto_llamada = "¡Eh! ¡Esperá!"
texto_victoria = "¡No puede ser! Bueno, era el primer combate...

La próxima no te va a ser tan fácil."
texto_derrota = "¡Te gané! Igual tu Pokémon tiene garra, ¿eh?"
texto_despues = "¡Nos vemos!"
texto_curar = "Tomá, dejame curar a tu Pokémon. Tengo una Poción de sobra."
texto_salida = "Me voy a entrenar a la Reserva Ecológica. ¡Nos vemos en el camino!"
texto = "¡Soy Facu! Yo también le pedí un Pokémon al músico, y me quedé con el que le gana al tuyo.

¿Vemos quién entrena mejor?"
mirando = Vector2(-1, 0)


[node name="VecinaPaloma" parent="." unique_id=1999008602 instance=ExtResource("25_20dov")]
position = Vector2(72, 216)
script = ExtResource("26_fb42g")
objeto_regalo = "boleto_primera"
cantidad_regalo = 1
trinket_regalo = ""
clave_objeto = "r9_paloma"
texto_antes = "¡Una paloma de verdad! ¡Con esto la función es un éxito! Tomá, lo encontramos en la pieza del fondo y a nosotros no nos sirve."
texto_despues = "Esta noche hay función en el patio del conventillo. ¡Vos y tus Pokémon entran gratis!"
requiere_tipos = Array[String]([])
requiere_especies = Array[String](["pidove", "tranquill", "unfezant"])
texto_falta = "¡Esta noche hacemos «El conventillo de la Paloma» en el patio! Pero nos falta lo principal: la paloma. Si atrapás una, ¿nos la mostrás? En la plazoleta de enfrente siempre hay Pidove."
texto = "¡Esta noche hacemos «El conventillo de la Paloma» en el patio!"


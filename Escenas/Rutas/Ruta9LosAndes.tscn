[node name="Calesitero" parent="." unique_id=1999008602 instance=ExtResource("22_5n5wy")]
position = Vector2(360, 312)
script = ExtResource("23_y0hhh")
texto_pregunta = "¡Pase, pase! ¿Una vuelta en la calesita? Si sacás la sortija, hay premio."
texto_no = "¡Cuando quieras! La calesita gira hasta tarde."
texto_nada = "¡Uy, esta vez no! La sortija es mañosa. ¡Probá otra vuelta!"
texto_repetido = "¡Muy bien! Pero esos premios ya te los di. ¡Sos un campeón de la sortija!"
texto = "¡Pase, pase! ¿Una vuelta en la calesita?"


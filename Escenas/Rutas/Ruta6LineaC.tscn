[node name="Guardaparque" parent="." unique_id=1999008602 instance=ExtResource("20_k7v7g")]
position = Vector2(216, 72)
script = ExtResource("21_e434d")
balls = 20
kit_alfajores = 3
kit_barro = 3
premio_trinket = "cofre_dorado"
texto_bienvenida = "¡Bienvenido a la reserva! Acá los Pokémon están protegidos: no se pelea, solo se observa y se atrapa."
texto_reglas = "Tirales Alfajores para que se queden comiendo, o Barro para enojarlos: enojados se atrapan más fácil, pero se van antes."
texto = "Soy el guarda de la Línea C. Las vías viejas están cerradas, pero los Pokémon se metieron entre los escombros. Pasá, pero con cuidado."


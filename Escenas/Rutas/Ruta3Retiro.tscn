[node name="Guardaparque" parent="." unique_id=1999008602 instance=ExtResource("19_7ue2d")]
position = Vector2(120, 504)
script = ExtResource("20_8su3f")
balls = 20
kit_alfajores = 3
kit_barro = 3
premio_trinket = "esfera_voraz"
texto_bienvenida = "¡Hola! Cuido la vieja playa ferroviaria de Retiro. Entre las vías crecieron pastizales, y ahora es zona protegida."
texto_reglas = "Tirales Alfajores para que se queden comiendo, o Barro para enojarlos: enojados se atrapan más fácil, pero se van antes."
texto = "La playa de maniobras quedó abandonada y se llenó de Pokémon. Los de noche son los más esquivos."
mirando = Vector2(-1, 0)


[node name="Cronista" parent="." unique_id=1999008602 instance=ExtResource("18_b0yuj")]
position = Vector2(648, 200)
texto = "Este parque fue el Cementerio del Sud. En 1871 la fiebre amarilla lo llenó y la ciudad abrió la Chacarita: un tren llevaba a los difuntos por la avenida Corrientes. Dicen que, de noche, una lucecita violeta todavía busca ese tren."
mirando = Vector2(-1, 0)


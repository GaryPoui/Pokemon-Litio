[node name="Canillita" parent="." unique_id=867988896 instance=ExtResource("21_0ossy")]
position = Vector2(104, 104)
texto = "¡Diario, diario! La avenida más ancha del mundo, dicen. Para cruzarla entera hacen falta varios semáforos: usá siempre las sendas peatonales."
mirando = Vector2(-1, 0)


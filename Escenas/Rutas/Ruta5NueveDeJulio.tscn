datos_snivy = ExtResource("27_vw5qr")
datos_tepig = ExtResource("28_vs5ud")
datos_oshawott = ExtResource("29_jd2xp")
fila_disparo = 49
salida = Vector2(1, 0)
tiempo_paso = 0.2
texto_llamada = "¡Eh! ¡Esperá!"
texto_victoria = "¿Otra vez? Mis Pokémon pelearon con todo...

Está bien, lo reconozco: sos bueno. Pero no pienso aflojar."
texto_derrota = ""
texto_despues = "¡Nos vemos!"
texto_curar = "Tomá, curemos a todos. En Constitución vas a necesitar el equipo entero."
texto_salida = "Dicen que la líder de los Talleres del Roca te llena la cancha de trampas. ¡Nos vemos más adelante!"
texto = "¡Por fin llegás! Desde La Boca que espero la revancha.

Armé un equipo que se enoja cuando cae un compañero: cada vez que cae uno, el que sigue sale con más bronca. ¡Vamos!"


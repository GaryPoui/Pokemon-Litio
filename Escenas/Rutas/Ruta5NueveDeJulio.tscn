[node name="Turista" parent="." unique_id=353514463 instance=ExtResource("21_0ossy")]
position = Vector2(328, 808)
texto = "¡El Cabildo! Acá, el 25 de mayo de 1810, se formó la Primera Junta, el primer gobierno patrio. Por eso la avenida de enfrente se llama Avenida de Mayo."
mirando = Vector2(0, -1)


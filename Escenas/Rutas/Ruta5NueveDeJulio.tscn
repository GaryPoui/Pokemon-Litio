[node name="Guardaparque" parent="." unique_id=1999008602 instance=ExtResource("21_0ossy")]
position = Vector2(216, 56)
script = ExtResource("22_yl3nh")
balls = 20
kit_alfajores = 3
kit_barro = 3
premio_trinket = "incienso_llamada"
texto_bienvenida = "¡Bienvenido a la reserva! Acá los Pokémon están protegidos: no se pelea, solo se observa y se atrapa."
texto_reglas = "Tirales Alfajores para que se queden comiendo, o Barro para enojarlos: enojados se atrapan más fácil, pero se van antes."
texto = "Cuido los canteros de la 9 de Julio. En el pasto de en medio de la avenida viven más Pokémon de los que imaginás."


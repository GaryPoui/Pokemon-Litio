[node name="Guardaparque" parent="." unique_id=1999008602 instance=ExtResource("20_1ppp8")]
position = Vector2(392, 568)
script = ExtResource("21_w20rp")
balls = 20
kit_alfajores = 3
kit_barro = 3
premio_trinket = "cebo_raro"
texto_bienvenida = "¡Bienvenido a Puerto Madero! Los parques de la costanera también son zona protegida: acá no se pelea."
texto_reglas = "Tirales Alfajores para que se queden comiendo, o Barro para enojarlos: enojados se atrapan más fácil, pero se van antes."
texto = "Cuido los parques y diques de Puerto Madero. Por las noches los Woobat salen de los depósitos."
mirando = Vector2(1, 0)


[node name="Anciano" parent="." unique_id=1539251347 instance=ExtResource("19_rgsmx")]
position = Vector2(232, 392)
texto = "Rivadavia pidió no volver nunca a Buenos Aires, y lo enterraron en el medio de la plaza. Dicen que sus dos guardianes de bronce se mueven cuando nadie los mira. Si te alcanzan por la espalda, te espantan hasta la reja… pero si los llevás a un pedestal, se quedan quietos para siempre."
mirando = Vector2(0, -1)


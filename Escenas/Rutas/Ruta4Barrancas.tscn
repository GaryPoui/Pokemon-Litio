[node name="Guardaparque" parent="." unique_id=1999008602 instance=ExtResource("18_h12mg")]
position = Vector2(72, 104)
script = ExtResource("19_acxes")
balls = 20
kit_alfajores = 3
kit_barro = 3
premio_trinket = "olfato_fino"
texto_bienvenida = "¡Bienvenido a la reserva! Acá los Pokémon están protegidos: no se pelea, solo se observa y se atrapa."
texto_reglas = "Tirales Alfajores para que se queden comiendo, o Barro para enojarlos: enojados se atrapan más fácil, pero se van antes."
texto = "Soy el guardaparque de las Barrancas. Esta plaza tiene árboles de más de cien años: cuidalos."
mirando = Vector2(0, -1)


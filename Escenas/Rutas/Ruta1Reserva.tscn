[node name="Guardaparque" parent="." unique_id=1999008602 instance=ExtResource("15_5jgps")]
position = Vector2(88, 248)
script = ExtResource("16_vesfh")
balls = 20
kit_alfajores = 3
kit_barro = 3
premio_trinket = "red_de_seda"
texto_bienvenida = "¡Bienvenido a la reserva! Acá los Pokémon están protegidos: no se pelea, solo se observa y se atrapa."
texto_reglas = "Tirales Alfajores para que se queden comiendo, o Barro para enojarlos: enojados se atrapan más fácil, pero se van antes."
texto = "Soy la guardaparque de la Costanera Sur. Cuidá los nidos y no dejes basura."


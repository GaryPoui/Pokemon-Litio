[node name="CartelCoipos" type="Node2D" parent="." unique_id=707584749]
position = Vector2(184, 472)
script = ExtResource("12_q2c5o")
texto = "LAGUNA DE LOS COIPOS

Los coipos son roedores nadadores que viven entre los juncos. Si ves algo moverse en la orilla, puede ser uno."

[node name="CartelCeibo" type="Node2D" parent="." unique_id=449027441]
position = Vector2(488, 296)
script = ExtResource("12_q2c5o")
texto = "EL CEIBO


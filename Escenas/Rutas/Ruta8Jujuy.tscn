[node name="Guardaparque" parent="." unique_id=1999008602 instance=ExtResource("20_ik4ij")]
position = Vector2(152, 808)
script = ExtResource("21_u03cr")
balls = 20
kit_alfajores = 3
kit_barro = 3
premio_trinket = "bandoneon_bolsillo"
tablas = ["res://Datos/Encuentros/plaza_miserere.tres", "res://Datos/Encuentros/plaza_miserere_raros.tres", "res://Datos/Encuentros/abasto.tres", "res://Datos/Encuentros/abasto_raros.tres"]
texto_bienvenida = "¡Bienvenido a la reserva! Acá los Pokémon están protegidos: no se pelea, solo se observa y se atrapa."
texto_reglas = "Tirales Alfajores para que se queden comiendo, o Barro para enojarlos: enojados se atrapan más fácil, pero se van antes."
texto = "Soy el guardaparque de la Ruta 8. De Once al Abasto los Pokémon se observan y se atrapan, como en toda la reserva."

[node name="AnimatedSprite2D" parent="Guardaparque" index="0" unique_id=1100079311]
position = Vector2(0, -7)
sprite_frames = ExtResource("22_skvnp")
animation = &"abajo"

[node name="Modista" parent="." unique_id=1374736405 instance=ExtResource("20_ik4ij")]
position = Vector2(88, 760)
script = ExtResource("23_4x5bq")
objeto_regalo = "tm89"
cantidad_regalo = 1
trinket_regalo = ""
clave_objeto = "r8_modista"
texto_antes = "¡Mirá cómo teje! Este sí sabe ir y volver con la aguja. Tomá, una máquina que enseña justamente eso: ir, pegar y volver."
texto_despues = "Ida y Vuelta: golpeás y volvés a tu lugar. Como una buena puntada."
requiere_tipos = Array[String]([])
requiere_especies = Array[String](["sewaddle", "swadloon", "leavanny", "burmy", "wormadam", "spinarak", "ariados"])
texto_falta = "Me falta un ayudante que teja: un Sewaddle, un Spinarak… cualquier Pokémon que teja hilo. ¿Me traés uno para verlo trabajar?"
texto = "Coso, corto y remiendo desde que Once era Once. Las mejores telas de Buenos Aires pasan por estas manos."

[node name="AnimatedSprite2D" parent="Modista" index="0" unique_id=1100079311]
position = Vector2(0, -7)
sprite_frames = ExtResource("24_7ws7n")
animation = &"abajo"

[node name="Vendedora" parent="." unique_id=479263986 instance=ExtResource("20_ik4ij")]
position = Vector2(184, 600)
script = ExtResource("25_0hphx")
texto_pregunta = "¿Querés que reacomode los rollos de la galería?"
texto_si = "¡Listo! Todo en su lugar, como recién llegado."
llegada = "Galeria"
clave_resuelto = "r8_galeria"
texto_resuelto = "La galería quedó despejada: tapé los sótanos con los rollos que cayeron. Pasá tranquilo, para un lado o para el otro."
texto = "Ojo en la galería: los sótanos están abiertos y los rollos ruedan hasta que chocan con algo. Si un rollo cae en un sótano, lo tapa."


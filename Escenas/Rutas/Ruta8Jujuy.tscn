[node name="CartelEntrada" type="Node2D" parent="." unique_id=12440762]
position = Vector2(88, 840)
script = ExtResource("18_e1ltp")
texto = "RUTA 8 · AV. JUJUY

Once, el barrio de las telas. Zona protegida: los Pokémon no se combaten, solo se atrapan. Al norte: Plaza Miserere."
mostrar_encuentros = true

[node name="CartelGaleria" type="Node2D" parent="." unique_id=1902021510]
position = Vector2(104, 600)
script = ExtResource("18_e1ltp")
texto = "GALERÍA ONCE · MAYORISTA DE TELAS

Único paso al norte. Cuidado: sótanos abiertos."


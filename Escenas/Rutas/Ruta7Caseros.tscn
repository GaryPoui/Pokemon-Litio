[node name="Guardaparque" parent="." unique_id=1999008602 instance=ExtResource("19_q2rv3")]
position = Vector2(584, 88)
script = ExtResource("20_53tfp")
balls = 20
kit_alfajores = 3
kit_barro = 3
premio_trinket = "luz_mala"
tablas = ["res://Datos/Encuentros/parque_ameghino.tres", "res://Datos/Encuentros/parque_ameghino_raros.tres", "res://Datos/Encuentros/corrales_viejos.tres", "res://Datos/Encuentros/corrales_viejos_raros.tres"]
texto_bienvenida = "¡Bienvenido a la reserva! Acá los Pokémon están protegidos: no se pelea, solo se observa y se atrapa."
texto_reglas = "Tirales Alfajores para que se queden comiendo, o Barro para enojarlos: enojados se atrapan más fácil, pero se van antes."
texto = "Soy la guardaparque de la Ruta 7. De acá hasta los Corrales Viejos, los Pokémon no se combaten: se observan y se atrapan."
mirando = Vector2(1, 0)


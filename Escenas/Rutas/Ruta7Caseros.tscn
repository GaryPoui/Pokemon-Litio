[node name="ChicoRanas" parent="." unique_id=1495273686 instance=ExtResource("19_q2rv3")]
position = Vector2(552, 360)
script = ExtResource("22_og2uf")
objeto_regalo = "tm18"
cantidad_regalo = 1
trinket_regalo = ""
clave_objeto = "r7_ranas"
texto_antes = "¡Una rana de verdad! ¡Mirá cómo croa! Tomá, esto lo encontré en un charco: hace llover cuando quieras."
texto_despues = "La Danza Lluvia es el baile favorito de las ranas. ¡Llueve y salen todas!"
requiere_tipos = Array[String]([])
requiere_especies = ["tympole", "palpitoad", "seismitoad", "croagunk", "toxicroak", "poliwag", "poliwhirl", "poliwrath", "politoed"]
texto_falta = "¡Yo colecciono ranas! ¿Me traés un Pokémon rana para verlo de cerca? Un Tympole, un Croagunk… ¡cualquier rana!"
texto = "Este era el Barrio de las Ranas: cuando llovía se inundaba todo y se llenaba de ranas. ¡Ahora también!"
mirando = Vector2(0, -1)


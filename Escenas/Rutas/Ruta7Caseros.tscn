[node name="Pescador" parent="." unique_id=759678195 instance=ExtResource("19_q2rv3")]
position = Vector2(440, 168)
texto = "Las latas flotan, pero cada una aguanta un solo paso. Si te quedás varado en el medio, te saco con la caña. Si volvés a la orilla, las latas vuelven a flotar."
mirando = Vector2(-1, 0)


premio_trinket = "penacho_negro"
tablas = ["res://Datos/Encuentros/villa_crespo.tres", "res://Datos/Encuentros/villa_crespo_raros.tres", "res://Datos/Encuentros/arroyo_maldonado.tres", "res://Datos/Encuentros/arroyo_maldonado_raros.tres", "res://Datos/Encuentros/parque_los_andes.tres", "res://Datos/Encuentros/parque_los_andes_raros.tres"]
texto_bienvenida = "¡Bienvenido a la reserva! Acá los Pokémon están protegidos: no se pelea, solo se observa y se atrapa."
texto_reglas = "Tirales Alfajores para que se queden comiendo, o Barro para enojarlos: enojados se atrapan más fácil, pero se van antes."
texto = "Soy la guardaparque de la Ruta 9, la última antes de la Chacarita. Acá también los Pokémon se observan y se atrapan."
mirando = Vector2(0, -1)


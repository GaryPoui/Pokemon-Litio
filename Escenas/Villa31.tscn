[node name="GuayMarcos" parent="." unique_id=1021019218 instance=ExtResource("24_y26oo")]
position = Vector2(424, 296)
script = ExtResource("29_kpimc")
datos = ExtResource("30_tpbfu")
clave = "vencio_guay_marcos"
texto_derrota = "Uh... tu estrategia es mejor que mis Trinkets."
texto_despues = "Los Trinkets no lo son todo. También cuenta cómo los combinás."
texto = "¡Entreno en la cancha todos los días! Mis Pokémon llevan Trinkets elegidos con cuidado. ¡A ver si estás a la altura!"

[node name="AnimatedSprite2D" parent="GuayMarcos" index="0" unique_id=1100079311]
position = Vector2(0, -7)
sprite_frames = ExtResource("30_a7awb")
animation = &"abajo"

[node name="GuayLucia" parent="." unique_id=1998183646 instance=ExtResource("24_y26oo")]
position = Vector2(536, 296)
script = ExtResource("29_kpimc")
datos = ExtResource("32_q6cu1")
clave = "vencio_guay_lucia"
texto_derrota = "¡Increíble! Ni mi Vendaje pudo salvarme."
texto_despues = "Si querés más combates, en cada barrio hay entrenadores esperándote."
texto = "¿Venís de las reservas? Allá no se pelea, pero acá en la cancha sí. ¡Demostrá lo que tenés!"

[node name="AnimatedSprite2D" parent="GuayLucia" index="0" unique_id=1100079311]
position = Vector2(0, -7)
sprite_frames = ExtResource("32_0l0yg")

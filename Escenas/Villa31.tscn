[node name="Vecina" parent="." unique_id=1984889237 instance=ExtResource("24_y26oo")]
position = Vector2(472, 440)
texto = "Vivo en el barrio hace cincuenta años. Lo levantamos entre todos, ladrillo por ladrillo. Ahora tenemos hasta Centro Pokémon."
mirando = Vector2(0, -1)


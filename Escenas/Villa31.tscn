texto_derrota = "¡Uy! Me hiciste perder el compás."
texto_despues = "En febrero la murga sale por todo el barrio. ¡Vení a verla!"
texto = "¡Ensayamos para el carnaval! Mi Purrloin baila mejor que nadie. ¿Te animás a un combate a puro ritmo?"
mirando = Vector2(-1, 0)


[node name="Guia" parent="." unique_id=1999008602 instance=ExtResource("40_knnfc")]
position = Vector2(344, 552)
texto = "Bienvenido a la Chacarita, el Cementerio del Oeste. Lo abrieron en 1871, cuando la fiebre amarilla no dejó lugar en ningún otro lado. El tranvía fúnebre llegaba hasta este mismo pórtico."
mirando = Vector2(1, 0)


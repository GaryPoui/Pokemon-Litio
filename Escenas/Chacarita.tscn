clave = "anima_medallon"
objeto_pedido = "medallon_viejo"
movimientos_pedidos = Array[String]([])
texto_pide = "...perdí mi medallón entre las lápidas el día de mi boda. Adentro está su retrato. Sin él no puedo irme."
texto_falta = "...mi medallón... tiene que estar entre las lápidas..."
texto_gracias = "¡Mi medallón! Todavía se ve su cara... Gracias. Ahora sí puedo esperarlo tranquila."
texto_despues = "...ya no lo busco. Ahora lo espero."
texto_premio = "Las tres ánimas de la Chacarita ya descansan. Donde estaba parada quedó una flor que no se marchita."


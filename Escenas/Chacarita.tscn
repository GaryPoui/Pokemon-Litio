[node name="VisitanteGardel" parent="." unique_id=1968543353 instance=ExtResource("40_knnfc")]
position = Vector2(456, 248)
texto = "Vengo todos los jueves a traerle flores a Carlitos. Mi abuela decía que cada día canta mejor, y tenía razón."

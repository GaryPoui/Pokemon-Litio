[node name="Florista" parent="." unique_id=290588627 instance=ExtResource("40_knnfc")]
position = Vector2(520, 552)
script = ExtResource("42_sjb7k")
producto = "ramo_flores"
clave_anima = "anima_flores"
texto_tiene = "Ya llevás un ramo. Dejalo en la tumba que te pidieron antes de que se marchite."
texto_listo = "Vi flores frescas en la bóveda de los Santángelo. Qué lindo gesto."
texto_chau = "Cuando quieras. Las flores no se van a ningún lado."
texto = "¡Flores frescas! Claveles, siemprevivas, crisantemos..."


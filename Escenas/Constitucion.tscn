[node name="VecinaSubte" parent="." unique_id=1999008602 instance=ExtResource("33_0qh20")]
position = Vector2(488, 280)
texto = "¡Bienvenido a Constitución! Acá llegan los trenes del Roca, el subte C y colectivos de toda la ciudad. Por la plaza pasa medio Buenos Aires por día."
mirando = Vector2(-1, 0)

[node name="AnimatedSprite2D" parent="VecinaSubte" index="0" unique_id=1100079311]
position = Vector2(0, -7)
sprite_frames = ExtResource("34_jmgxs")
animation = &"abajo"

[node name="Diariero" parent="." unique_id=1405094391 instance=ExtResource("33_0qh20")]
position = Vector2(408, 296)
texto = "¡Diario, diario! Hoy sale la Guarda en la tapa: dicen que en los Talleres del Roca nadie le gana en hora pico."

[node name="AnimatedSprite2D" parent="Diariero" index="0" unique_id=1100079311]
position = Vector2(0, -7)
sprite_frames = ExtResource("35_btxph")
animation = &"abajo"

[node name="Ferroviaria" parent="." unique_id=813540504 instance=ExtResource("33_0qh20")]
position = Vector2(680, 328)
texto = "Esos son los Talleres del Roca, el gimnasio de la ciudad. La Guarda tira púas y rocas en las vías, y después toca el silbato para que cambies de Pokémon. Llevá un Pokémon que aguante quedarse en el campo."
mirando = Vector2(-1, 0)

[node name="AnimatedSprite2D" parent="Ferroviaria" index="0" unique_id=1100079311]
position = Vector2(0, -7)
sprite_frames = ExtResource("36_lf20g")
animation = &"abajo"

[node name="Choripanero" parent="." unique_id=1669796381 instance=ExtResource("33_0qh20")]
position = Vector2(680, 392)
texto = "¡Choripán, bondiola, vacío! Los viajeros del Roca comen acá antes de subir al tren. Los Pokémon se arriman por el olorcito."
mirando = Vector2(-1, 0)

[node name="AnimatedSprite2D" parent="Choripanero" index="0" unique_id=1100079311]
position = Vector2(0, -7)
sprite_frames = ExtResource("37_cd0n8")
animation = &"abajo"

[node name="Nene" parent="." unique_id=1693982131 instance=ExtResource("33_0qh20")]
position = Vector2(280, 344)
texto = "¡Las palomas de la plaza no le tienen miedo a nadie! Una vez una se subió a la cabeza de mi Pidove."
mirando = Vector2(1, 0)

[node name="AnimatedSprite2D" parent="Nene" index="0" unique_id=1100079311]
position = Vector2(0, -7)
sprite_frames = ExtResource("38_o7fp6")
animation = &"abajo"

[node name="Pasajero" parent="." unique_id=174296797 instance=ExtResource("33_0qh20")]
position = Vector2(296, 456)
texto = "Espero el 60 para volver a casa. Va de Constitución hasta Tigre: casi dos horas de viaje, pero conozco a todos los choferes."

[node name="AnimatedSprite2D" parent="Pasajero" index="0" unique_id=1100079311]
position = Vector2(0, -7)
sprite_frames = ExtResource("39_ijjwh")
animation = &"abajo"

[node name="Obrero" parent="." unique_id=612100689 instance=ExtResource("33_0qh20")]

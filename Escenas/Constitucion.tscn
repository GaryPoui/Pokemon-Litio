[node name="CartelEstacion" type="Node2D" parent="." unique_id=1695604578]
position = Vector2(392, 152)
script = ExtResource("31_sf5xl")
texto = "ESTACIÓN CONSTITUCIÓN · FERROCARRIL ROCA


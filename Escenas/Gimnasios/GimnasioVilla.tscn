[node name="DjNico" parent="." unique_id=163279876 instance=ExtResource("11_hm3x7")]
position = Vector2(56, 136)
script = ExtResource("15_u45jv")
datos = ExtResource("18_hs21o")
clave = "vencio_dj_nico"
texto_derrota = "Se me cortó el tema..."
texto_despues = "La térmica de la pista está abajo a la izquierda, contra la pared."
texto = "¡Sin luz no hay fiesta! Bah, mis Pokémon bailan igual. ¡A ver si les seguís el ritmo!"


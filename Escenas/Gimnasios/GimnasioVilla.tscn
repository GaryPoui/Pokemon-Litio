[node name="LaGata" parent="." unique_id=1999008602 instance=ExtResource("11_hm3x7")]
position = Vector2(152, 56)
script = ExtResource("12_0004r")
medalla = "terraza"
nombre_medalla = "Medalla Terraza"
requiere_medalla = "bombonera"
texto_requisito = "¿Y vos quién sos? Acá arriba solo suben los que ya le ganaron a Riquelme. Volvé con la Medalla Bombonera."
mt_premio = "tm95"
trinket_premio = "reloj_arena"
texto_premio = "Tomá este Disco Técnico: Alarido baja el Ataque Especial de quien lo recibe. Y este Reloj de Arena: aguanta un golpe que te tiraría."
datos = ExtResource("13_ohoj5")
clave = "vencio_la_gata"
texto_derrota = "Miau... Me ganaste limpio, y eso en este barrio vale oro."
texto_despues = "Si te agrandan, no te la creas: cambiá de Pokémon y se te pasa. Eso también es saber pelear."
texto = "Llegaste hasta el escenario a oscuras... Nada mal. Soy Rocío, pero en el barrio me dicen La Gata. En la oscuridad mis Pokémon te engañan, te agrandan y te usan la fuerza en contra. ¿Bailamos?"

[node name="AnimatedSprite2D" parent="LaGata" index="0" unique_id=1100079311]
position = Vector2(0, -7)
sprite_frames = ExtResource("13_44514")
animation = &"abajo"

[node name="PatovicaRamon" parent="." unique_id=1955974378 instance=ExtResource("11_hm3x7")]
position = Vector2(120, 248)
script = ExtResource("15_u45jv")
datos = ExtResource("16_46kj8")
clave = "vencio_patovica_ramon"
texto_derrota = "Bueno, bueno... pasá. Pero no hagas lío."
texto_despues = "La térmica del salón está en la esquina del fondo, a la derecha. Andá tanteando."
texto = "¡Ey! Con la luz cortada no se pasa así nomás. Primero pasá por mí."

[node name="AnimatedSprite2D" parent="PatovicaRamon" index="0" unique_id=1100079311]
position = Vector2(0, -7)
sprite_frames = ExtResource("16_8lcyn")

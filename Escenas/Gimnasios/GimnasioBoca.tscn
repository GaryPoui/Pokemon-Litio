texto_derrota = "¡Dale, dale! Ganaste bien."
texto_despues = "Cuando sus Pokémon se dan vuelta las cosas, los más lentos atacan primero. ¡Usá eso a tu favor!"
texto = "¡La Bombonera no tiembla: late! Y mis Pokémon laten con ella."


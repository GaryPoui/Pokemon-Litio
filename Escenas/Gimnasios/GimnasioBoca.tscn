[node name="JuvenilTomi" parent="." unique_id=1690633338 instance=ExtResource("8_ww8cy")]
position = Vector2(312, 248)
script = ExtResource("12_hevwj")
datos = ExtResource("13_omte0")
clave = "vencio_juvenil_tomi"
texto_derrota = "¡Uh! Me pasaste por arriba como un caño."
texto_despues = "Empujá la pelota hasta el arquito de entrenamiento. Si se traba, salí y volvé a entrar."
texto = "¡Entreno con el Diez todos los días! ¿Vos sabés patear un tiro libre?"
mirando = Vector2(-1, 0)


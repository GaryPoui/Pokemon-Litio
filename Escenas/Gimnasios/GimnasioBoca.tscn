[node name="GuiaGimnasio" parent="." unique_id=1078146926 instance=ExtResource("8_ww8cy")]
position = Vector2(232, 264)
script = ExtResource("19_y7htd")
objeto_regalo = "super_potion"
cantidad_regalo = 2
trinket_regalo = ""
clave_objeto = "guia_gym_boca"
texto_antes = "¡Bienvenido! Riquelme usa Pokémon azul y oro, de agua y eléctricos. Juega lento a propósito y se pasa las mejoras. Tomá, esto te va a servir."
texto_despues = "Empujá cada pelota hasta un arco para abrir las barreras. Si se traba, salí y volvé a entrar."
requiere_tipos = Array[String]([])
texto_falta = ""
texto = "¡Bienvenido al gimnasio! Para llegar al Diez tenés que abrir dos barreras: empujá cada pelota hasta un arco. Si una pelota se traba, salí y volvé a entrar."


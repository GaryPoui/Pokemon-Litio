datos = ExtResource("15_xdg2a")
clave = "vencio_juvenil_lara"
texto_derrota = "¡Qué jugada! Me dejaste sin marca."
texto_despues = "Riquelme primero frena el partido y después pasa la pelota a su mejor jugador. ¡Ojo con eso!"
texto = "Azul y oro, como el barco que entró al puerto. ¡A ver si jugás tan bien como hablás!"
mirando = Vector2(-1, 0)


[node name="Riquelme" parent="." unique_id=1999008602 instance=ExtResource("8_ww8cy")]
position = Vector2(184, 72)
script = ExtResource("9_v8lyd")
medalla = "bombonera"
nombre_medalla = "Medalla Bombonera"
requiere_medalla = ""
texto_requisito = ""
mt_premio = "tm57"
trinket_premio = "diario_entrenamiento"
texto_premio = "Llevate también este Disco Técnico y mi Diario de Entrenamiento: con eso tus Pokémon van a aprender más rápido."
datos = ExtResource("10_v8e2m")
clave = "vencio_riquelme"
texto_derrota = "¡Qué partido! Me hiciste correr, y eso no es fácil. Te ganaste la medalla."
texto_despues = "El fútbol es de los que piensan. Seguí así: en Villa 31 te espera un rival que juega con trampas de verdad."
texto = "Bienvenido a la Bombonera. Acá la pelota no se apura: se la para, se hace la pausa y se da el pase justo. ¿Estás listo para jugar a mi ritmo?"


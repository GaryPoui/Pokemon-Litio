position = Vector2(0, -7)
sprite_frames = ExtResource("12_h2i3v")
animation = &"abajo"

[node name="MaquinistaRuben" parent="." unique_id=2102479301 instance=ExtResource("10_h7v3q")]
position = Vector2(216, 248)
script = ExtResource("14_8so3n")
datos = ExtResource("15_oer58")
clave = "vencio_maquinista_ruben"
texto_derrota = "¡Uy! Me descarrilaste."
texto_despues = "Las palancas mueven las mesas giratorias. Cada mesa tiene una palanca de cada lado."
texto = "¡Treinta años manejando el Roca! Mis Pokémon son duros como un riel."
mirando = Vector2(-1, 0)


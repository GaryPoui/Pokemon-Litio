clave = "vencio_mecanico_tito"
texto_derrota = "Se me aflojó una tuerca..."
texto_despues = "La Guarda pone púas y después toca el silbato para hacerte cambiar de Pokémon. Cada vez que entrás, te pinchás."
texto = "Aceito engranajes desde chico. ¡Mis Pokémon están bien ajustados!"

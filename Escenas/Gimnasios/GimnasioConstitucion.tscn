clave = "vencio_senalera_dora"
texto_derrota = "Señal en verde... pasá nomás."
texto_despues = "La mesa del medio cruza de lado a lado. Girala y seguí hacia el este."
texto = "¡Señal en rojo! No pasás sin pelear."


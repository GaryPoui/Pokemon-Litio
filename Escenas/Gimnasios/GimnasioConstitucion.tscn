[node name="LaGuarda" parent="." unique_id=1999008602 instance=ExtResource("10_h7v3q")]
position = Vector2(168, 56)
script = ExtResource("11_028qg")
medalla = "anden"
nombre_medalla = "Medalla Andén"
requiere_medalla = "terraza"
texto_requisito = "¡Alto ahí! Este andén es para entrenadores con la Medalla Terraza. Volvé cuando le hayas ganado a La Gata."
mt_premio = "tm91"
trinket_premio = "escama_robusta"
texto_premio = "Llevate este Disco Técnico: Foco Resplandor, puro acero. Y esta Escama Robusta, para que aguantes la hora pico."
datos = ExtResource("12_eocgt")
clave = "vencio_la_guarda"
texto_derrota = "¡Fiuuuu! Llegaste a destino. Te ganaste la Medalla Andén."
texto_despues = "En hora pico no conviene cambiar de vagón a cada rato: si te tiran púas, quedate y pegá fuerte."
texto = "Bienvenido a los Talleres del Roca. Soy la Guarda: acá cada tren sale a horario y nadie se baja donde quiere. Tiro las vías, toco el silbato, y vos vas y venís a mi ritmo. ¡A bordo!"

